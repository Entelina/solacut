# Python 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
*$py.class

# 环境变量、密钥、证书与本地日志（绝不上传到公开仓库）
.env
.env.*
!.env.example
.workbench_config.json
.media_bins.json
*.log
*.pem
*.key
*.p12
*.pfx

# 运行时输入录屏与输出成品（保留 .gitkeep）
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# 开源语料原始下载压缩包缓存、运行时清单、用户私有词库与大索引（可由 src/corpus_builder.py 一键重建）
data/corpus/raw_cache/
data/corpus/corpus_manifest.json
data/corpus/user_glossary.json
data/corpus/*/corpus_index.db
data/corpus/*/open_parallel_corpus.jsonl

# 常见 IDE 与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# 发布构建临时目录与便携包产物
release/
build_release_tmp/
dist/
build/

# Vercel 独立官网构建产物与依赖
website/node_modules/
website/dist/
website/.vercel/
