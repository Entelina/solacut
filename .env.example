# 复制本文件为 .env 后填入你的真实 API 配置（切勿将 .env 提交到 Git）
# =========================================================================
# 【极简模式（推荐）】使用 DeepSeek 全家桶时，只需填写下面第 1 行的真实密钥！
# 系统默认会自动：
#   - Step 2 语音识别 -> DeepSeek 官方云端 ASR (https://api.deepseek.com/v1/tools/asr)
#   - Step 3 高光粗筛 & 双语精修 -> deepseek-flash (1M 上下文，高速高性价比)
# =========================================================================

OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# =========================================================================
# 【高级三层路由（可选）】如需自由混搭不同厂商/模型，取消对应行注释即可：
# =========================================================================

# --- 第 1 层：独立语音识别引擎（ASR）---
# 可选值：deepseek（默认云端）/ local（本地 RTX Whisper）/ openai_compatible（Groq/OpenAI/硅基流动）
ASR_PROVIDER=deepseek
# ASR_API_KEY=留空则自动复用上面的 OPENAI_API_KEY
# ASR_BASE_URL=https://api.deepseek.com/v1/tools/asr
# ASR_MODEL=large-v3-turbo
# ASR_CONCURRENCY=4
# ASR_HOTWORDS=Shylily, Where Winds Meet, KEKW

# --- 第 2 层：高光粗筛模型（默认沿用上面的 LLM_MODEL=deepseek-flash）---
# SCREEN_LLM_MODEL=deepseek-flash
# SCREEN_LLM_BASE_URL=https://api.deepseek.com/v1
# SCREEN_LLM_API_KEY=
# SCREEN_LLM_REASONING_EFFORT=

# --- 第 3 层：双语字幕精修模型（留空则沿用粗筛配置，也可单独切顶级文采模型）---
# POLISH_LLM_MODEL=deepseek-flash
# POLISH_LLM_BASE_URL=
# POLISH_LLM_API_KEY=
# POLISH_LLM_REASONING_EFFORT=
